rk", "dur": 6.356122448979591, "camera": {"frame": "wide", "push": 0.04}, "actors": [{"id": "alex", "x": 42.0, "pose": "sit", "mood": "hopeful"}, {"id": "sam", "x": 58.0, "pose": "sit", "mood": "hopeful"}], "lines": [{"who": "narrator", "text": "Alex invites Sam to the bench, unveiling the sketch that now feels alive.", "at": 0.25}]}, {"time": "day", "weather": "gentle", "grade": "warm", "set": "park", "dur": 6.356122448979591, "camera": {"frame": "close", "on": "alex", "push": 0.06}, "actors": [{"id": "alex", "x": 50, "pose": "sit", "mood": "hopeful"}], "lines": [{"who": "narrator", "text": "Together they discuss its colors, realizing a shared purpose can anchor fleeting thoughts.", "at": 0.25}]}], "9": [{"time": "night", "weather": "still", "grade": "cold", "set": "scene", "scene": {"base": "stage", "elements": []}, "dur": 7.988775510204081, "camera": {"frame": "wide", "push": 0.04}, "actors": [{"id": "alex", "x": 50.0, "pose": "sit", "mood": "determined"}], "lines": [{"who": "narrator", "text": "Shadow steps forward, voice low and echoing, \"Your meaning is arbitrary, a mere trick of the mind.", "at": 0.25}]}, {"time": "night", "weather": "still", "grade": "cold", "set": "scene", "scene": {"base": "stage", "elements": []}, "dur": 3.9071428571428566, "camera": {"frame": "close", "on": "alex", "push": 0.06}, "actors": [{"id": "alex", "x": 50, "pose": "sit", "mood": "determined"}], "lines": [{"who": "narrator", "text": "It holds no weight against the void.\"", "at": 0.25}]}, {"time": "night", "weather": "still", "grade": "cold", "set": "scene", "scene": {"base": "stage", "elements": []}, "dur": 5.947959183673468, "camera": {"frame": "wide", "on": "alex", "push": 0.05}, "actors": [{"id": "alex", "x": 50, "pose": "sit", "mood": "determined"}], "lines": [{"who": "narrator", "text": "Alex turns, eyes steady, and gestures toward the sketchbook on the bench.", "at": 0.25}]}, {"time": "night", "weather": "still", "grade": "cold", "set": "scene", "scene": {"base": "stage", 