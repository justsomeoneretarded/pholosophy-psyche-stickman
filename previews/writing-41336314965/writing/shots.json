ill", "grade": "cold", "scene": {"base": "stage", "elements": [{"type": "bench", "x": 50}, {"type": "spotlight", "x": 50}]}, "camera": {"frame": "close", "push": 0.05}, "actors": [{"id": "alex", "x": 50, "pose": "stand", "mood": "determined", "facing": -1}], "lines": [{"who": "narrator", "text": "It holds no weight against the void.\"'}", "at": 0.25}, {"who": "alex", "text": "It doesn't need to be absolute to be real. The fact that I chose this, and that it anchors my days, makes it true for me. The void is empty, but my choice fills it.", "at": 0.2}]}, {"dur": 10.0, "set": "scene", "time": "night", "weather": "still", "grade": "cold", "scene": {"base": "stage", "elements": [{"type": "bench", "x": 50}, {"type": "spotlight", "x": 50}]}, "camera": {"frame": "wide", "on": "alex", "push": 0.05}, "actors": [{"id": "alex", "x": 50, "pose": "stand", "mood": "determined", "facing": -1}], "lines": [{"who": "narrator", "text": "{'text': 'Alex turns, eyes steady, and gestures toward the sketchbook on the bench.", "at": 0.25}]}, {"dur": 10.0, "set": "scene", "time": "night", "weather": "still", "grade": "cold", "scene": {"base": "stage", "elements": [{"type": "bench", "x": 50}, {"type": "spotlight", "x": 50}]}, "camera": {"frame": "medium", "on": "alex", "push": 0.05}, "actors": [{"id": "alex", "x": 50, "pose": "stand", "mood": "determined", "facing": -1}], "lines": [{"who": "narrator", "text": "\"It doesn\\'t need to be absolute to be real.", "at": 0.25}]}, {"dur": 10.0, "set": "scene", "time": "night", "weather": "still", "grade": "cold", "scene": {"base": "stage", "elements": [{"type": "bench", "x": 50}, {"type": "spotlight", "x": 50}]}, "camera": {"frame": "close", "on": "alex", "push": 0.05}, "actors": [{"id": "alex", "x": 50, "pose": "stand", "mood": "determined", "facing": -1}], "lines": [{"who": "narrator", "text": "The fact that I chose this, and that it anchors my days, makes it true for me.", "at": 0.25}]}, {"dur": 10.0, "set": "scene", "time": "night", "weather": "s